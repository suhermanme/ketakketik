{
  "name": "ketakketik",
  "productName": "KetakKetik",
  "version": "1.0.0",
  "description": "Cross-platform typing trainer with adaptive learning engine",
  "main": "dist/electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc && node scripts/dev-electron.mjs",
    "build": "tsc && vite build",
    "build:web": "vite build --config vite.web.config.ts",
    "build:electron": "tsc --outDir dist-ee && vite build && cp -r dist-ee/electron dist-ee/icons dist/ 2>/dev/null || true && electron-builder || true",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "eslint": "^9.0.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tslib": "^1.0.0",
    "typescript": "^5.4.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^1.6.0",
    "wait-on": "^8.0.0"
  },
  "engines": {
    "node": ">= 18.0.0"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "build": {
    "appId": "com.ketakketik.app",
    "productName": "KetakKetik",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "icon": "build/icons/KetakKetik.icns"
    },
    "linux": {
      "icon": "public/icons/icon-512.png"
    },
    "win": {
      "icon": "public/icons/icon-512.png"
    }
  }
}
